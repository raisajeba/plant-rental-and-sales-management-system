APP_NAME=GreenNest API
DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=greennest
DB_USER=greennest_user
DB_PASSWORD=change_me

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JSON list
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000","http://localhost:5173"]
# Optional: auto-create the first admin at startup
ADMIN_NAME=GreenNest Admin
ADMIN_EMAIL=admin@greennest.com
ADMIN_PASSWORD=Admin@12345